# =============================================================================
# Multi-Agent Competitive Intelligence Orchestrator — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# All API keys should be kept secret and never committed to version control.

# --- Mode ---
# Set to "true" for demo mode (no real API calls), "false" for live mode
DEMO_MODE=true

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ci_orchestrator
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ci_orchestrator

# --- LLM Configuration ---
# Supported providers: openai, anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-api-key-here

# For Anthropic:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-sonnet-20241022
# LLM_API_KEY=your-anthropic-key-here

# --- Pinecone (Vector DB for Financial RAG) ---
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=ci-orchestrator

# --- News API ---
# Get a free key at https://newsapi.org/
NEWS_API_KEY=your-newsapi-key

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- Logging ---
LOG_LEVEL=INFO

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
